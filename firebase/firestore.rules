rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  match /households/{uid} {
   allow read, delete: if owner(uid);
   allow create: if owner(uid) && request.resource.data.keys().hasOnly(['monthlyBudget','months','days','rollover','createdAt','updatedAt']);
   allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['monthlyBudget','months','days','rollover','updatedAt']);
   match /inventory/{itemId} {
    allow read, delete: if owner(uid);
    allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['name','category','quantity','expiry','updatedAt'])
      && request.resource.data.name is string && request.resource.data.category is string
      && request.resource.data.quantity is number && request.resource.data.quantity >= 0;
   }
   match /purchases/{purchaseId} {
    allow read: if owner(uid);
    allow create: if owner(uid) && request.resource.data.keys().hasOnly(['itemId','name','quantity','cost','purchasedAt'])
      && request.resource.data.quantity is number && request.resource.data.quantity > 0
      && request.resource.data.cost is number && request.resource.data.cost >= 0;
    allow update, delete: if false;
   }
  }
 }
}